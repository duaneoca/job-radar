# ⚠️  This is an EXAMPLE. Never commit real secrets to git.
#
# Credentials for the nightly database backup (backup-cronjob.yaml).
#
# ── 1. Create the bucket (block public access is on by default; keep it) ──
#   aws s3api create-bucket --bucket job-radar-backups --region us-east-1
#   aws s3api put-public-access-block --bucket job-radar-backups \
#     --public-access-block-configuration \
#     BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
#   aws s3api put-bucket-versioning --bucket job-radar-backups \
#     --versioning-configuration Status=Enabled
#
# ── 2. Expire old dumps automatically (90 days is ~200 MB at current size) ──
#   aws s3api put-bucket-lifecycle-configuration --bucket job-radar-backups \
#     --lifecycle-configuration '{"Rules":[{"ID":"expire-old-dumps","Status":"Enabled",
#       "Filter":{"Prefix":"production/"},"Expiration":{"Days":90},
#       "NoncurrentVersionExpiration":{"NoncurrentDays":30}}]}'
#
# ── 3. A user that can ONLY write to this prefix ──
# Deliberately no s3:DeleteObject: if the cluster is ever compromised, the
# attacker must not be able to erase the backups. Expiry is the bucket's job
# (step 2), not the uploader's. Pruning by hand needs your own credentials.
#
#   aws iam create-user --user-name job-radar-backup
#   aws iam put-user-policy --user-name job-radar-backup --policy-name write-backups \
#     --policy-document '{"Version":"2012-10-17","Statement":[
#       {"Effect":"Allow","Action":["s3:PutObject"],
#        "Resource":"arn:aws:s3:::job-radar-backups/production/*"},
#       {"Effect":"Allow","Action":["s3:ListBucket"],
#        "Resource":"arn:aws:s3:::job-radar-backups",
#        "Condition":{"StringLike":{"s3:prefix":"production/*"}}}]}'
#   aws iam create-access-key --user-name job-radar-backup
#
# ── 4. Create the secret from the access key it printed ──
#   kubectl create secret generic db-backup-secrets \
#     --from-literal=AWS_ACCESS_KEY_ID='AKIA...' \
#     --from-literal=AWS_SECRET_ACCESS_KEY='...' \
#     --from-literal=AWS_DEFAULT_REGION='us-east-1' \
#     --from-literal=S3_BUCKET='job-radar-backups' \
#     --from-literal=S3_PREFIX='production' \
#     -n jobradar-production
#
# ── 5. Run it once by hand, don't wait for 02:00 ──
#   kubectl create job -n jobradar-production --from=cronjob/jobradar-db-backup backup-test
#   kubectl logs -n jobradar-production job/backup-test --all-containers -f
#
# Store this access key in 1Password alongside the cluster secrets — it is not
# recoverable from AWS after creation.

apiVersion: v1
kind: Secret
metadata:
  name: db-backup-secrets
  namespace: jobradar-production
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "AKIAEXAMPLE"
  AWS_SECRET_ACCESS_KEY: "example-secret"
  AWS_DEFAULT_REGION: "us-east-1"
  S3_BUCKET: "job-radar-backups"
  S3_PREFIX: "production"
