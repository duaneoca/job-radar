# ⚠️  EXAMPLE — never commit real secrets. Create the real secret in each namespace.
#
# AGENT_INTERNAL_TOKEN is the shared cloud-agent token. It MUST be byte-identical
# to AGENT_INTERNAL_TOKEN in `tracker-api-secrets` (tracker-api validates what the
# agent sends). Generate once and put the SAME value in both secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
#   kubectl create secret generic email-agent-secrets \
#     --from-literal=AGENT_INTERNAL_TOKEN='<same value as tracker-api-secrets>' \
#     --from-literal=LANGFUSE_PUBLIC_KEY='pk-lf-...' \
#     --from-literal=LANGFUSE_SECRET_KEY='sk-lf-...' \
#     --from-literal=SLACK_BOT_TOKEN='xoxb-...' \
#     --from-literal=TYPESAFE_API_KEY='...' \
#     -n jobradar-staging
#
# ⚠️ TYPESAFE_API_KEY is NOT in either hosted environment yet (checked 2026-11-13).
#    Its only home is job-radar-agent/.env on Duane's Mac; the hosted sorter stays
#    off (SORTER_ENABLED "false") until it is patched into BOTH namespaces.
# TYPESAFE_API_KEY is the sorter's Jev key (spec §3.7): ONE system-wide key for
# every user — admin-level, not BYOK, never in the DB or the cloud config. To add
# it to an existing secret without touching the other keys:
#
#   kubectl -n <namespace> patch secret email-agent-secrets --type merge \
#     -p "{\"stringData\":{\"TYPESAFE_API_KEY\":\"$TYPESAFE_API_KEY\"}}"
#
# then run scripts/check-secret-backup.py so the off-cluster backup includes it.
# Rotating = patch again; the next CronJob run picks it up. SORTER_ENABLED in
# email-agent-config stays "false" until the key is in both namespaces.
#
# Per-user LLM keys and mailbox creds are NOT here — the agent fetches those at
# runtime from /agent/cloud/config/{user_id} (one user in memory at a time, H6).

apiVersion: v1
kind: Secret
metadata:
  name: email-agent-secrets
  namespace: jobradar
type: Opaque
stringData:
  AGENT_INTERNAL_TOKEN: "CHANGE_ME"   # must equal tracker-api-secrets/AGENT_INTERNAL_TOKEN
  LANGFUSE_PUBLIC_KEY: "CHANGE_ME"
  LANGFUSE_SECRET_KEY: "CHANGE_ME"
  SLACK_BOT_TOKEN: "CHANGE_ME"        # xoxb- bot token for ops alerts
  TYPESAFE_API_KEY: "CHANGE_ME"       # sorter's Jev key — system-wide, see above
